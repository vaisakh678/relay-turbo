# --- Database ---
DATABASE_URL=postgres://relay:relay@localhost:5432/relay

# --- Server ---
PORT=3001
LOG_LEVEL=info

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public URL of this API (used for OAuth callbacks and cookies)
BETTER_AUTH_URL=http://localhost:3001
# Dashboard origin(s), comma-separated
WEB_ORIGINS=http://localhost:5173

# Optional social sign-in; leave blank to disable a provider.
# Callback URLs: {BETTER_AUTH_URL}/api/auth/callback/google and /callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email for sign-in codes (https://resend.com). Leave blank locally: codes print to the API log.
RESEND_API_KEY=
EMAIL_FROM=Relay <login@yourdomain.com>
